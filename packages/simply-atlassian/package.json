{
  "name": "@simplysf/simply-atlassian",
  "description": "Command-line interface for working with Atlassian products",
  "version": "0.9.0",
  "author": "@ClayChipps",
  "homepage": "https://github.com/SimplySF/simply-atlassian",
  "bugs": "https://github.com/SimplySF/simply-atlassian/issues",
  "repository": {
    "type": "git",
    "url": "https://github.com/SimplySF/simply-atlassian",
    "directory": "packages/simply-atlassian"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "/lib",
    "/oclif.lock",
    "/oclif.manifest.json"
  ],
  "keywords": [
    "oclif",
    "atlassian",
    "jira",
    "confluence",
    "simply"
  ],
  "license": "Apache-2.0",
  "exports": "./lib/index.js",
  "type": "module",
  "types": "./lib/index.d.ts",
  "bin": {
    "simply": "./bin/run.js"
  },
  "oclif": {
    "additionalVersionFlags": [
      "-v"
    ],
    "additionalHelpFlags": [
      "-h"
    ],
    "bin": "simply",
    "commands": "./lib/commands",
    "devPlugins": [
      "@oclif/plugin-command-snapshot"
    ],
    "flexibleTaxonomy": true,
    "plugins": [],
    "repositoryPrefix": "<%- repo %>/blob/@simplysf/simply-atlassian@<%- version %>/packages/simply-atlassian/<%- commandPath %>",
    "topicSeparator": " ",
    "topics": {
      "atlassian": {
        "description": "Work with Atlassian products."
      },
      "atlassian:jira": {
        "description": "Work with Jira issues and projects."
      },
      "atlassian:jira:user": {
        "description": "Look up Jira users."
      },
      "atlassian:jira:issue": {
        "description": "Read and manage Jira issues."
      },
      "atlassian:jira:issue:comment": {
        "description": "Read and add issue comments."
      },
      "atlassian:jira:issue:link": {
        "description": "Relate issues to one another."
      },
      "atlassian:jira:board": {
        "description": "List Jira agile boards."
      },
      "atlassian:jira:sprint": {
        "description": "List sprints, sprint issues, and add issues to sprints."
      },
      "atlassian:confluence": {
        "description": "Work with Confluence spaces and pages."
      },
      "atlassian:confluence:page:comment": {
        "description": "Read and add page comments."
      },
      "atlassian:confluence:page": {
        "description": "Read Confluence pages."
      }
    }
  },
  "dependencies": {
    "@oclif/core": "^4.11.2",
    "@simplysf/simply-atlassian-core": "workspace:^0.4.0"
  },
  "devDependencies": {
    "@oclif/plugin-command-snapshot": "^5.4.0",
    "@vitest/coverage-v8": "^4.1.10",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "wireit",
    "compile": "wireit",
    "fix-license": "eslint src test --fix --rule \"header/header: [2]\"",
    "format": "wireit",
    "lint": "wireit",
    "readme": "oclif readme --no-aliases",
    "test": "wireit",
    "test:coverage": "wireit",
    "test:only": "wireit",
    "test:watch": "wireit"
  },
  "wireit": {
    "build": {
      "dependencies": [
        "command-snapshot",
        "compile",
        "lint"
      ]
    },
    "compile": {
      "command": "tsc -p . --pretty --incremental",
      "files": [
        "src/**/*.ts",
        "**/tsconfig.json",
        "../../tsconfig.json"
      ],
      "output": [
        "lib/**",
        "*.tsbuildinfo"
      ],
      "clean": "if-file-deleted",
      "dependencies": [
        "../simply-atlassian-core:compile"
      ]
    },
    "format": {
      "command": "prettier --write \"+(src|test)/**/*.+(ts|js|json)|command-snapshot.json\"",
      "files": [
        "src/**/*.ts",
        "test/**/*.ts",
        "command-snapshot.json",
        ".prettier*"
      ],
      "output": []
    },
    "lint": {
      "command": "eslint src test --color --cache --cache-location .eslintcache",
      "files": [
        "src/**/*.ts",
        "test/**/*.ts",
        "**/.eslint*",
        "**/tsconfig.json",
        "../../eslint.config.mjs",
        "../../tsconfig.json"
      ],
      "output": [],
      "dependencies": [
        "../simply-atlassian-core:compile"
      ]
    },
    "test": {
      "dependencies": [
        "test:compile",
        "test:only",
        "lint"
      ]
    },
    "command-snapshot": {
      "command": "node --loader ts-node/esm --no-warnings=ExperimentalWarning \"./bin/dev.js\" snapshot:generate && prettier --write command-snapshot.json",
      "files": [
        "src/**/*.ts"
      ],
      "output": [
        "command-snapshot.json"
      ],
      "dependencies": [
        "compile"
      ]
    },
    "test:compile": {
      "command": "tsc -p \"./test\" --pretty",
      "files": [
        "test/**/*.ts",
        "**/tsconfig.json",
        "../../tsconfig.json"
      ],
      "output": [],
      "dependencies": [
        "../simply-atlassian-core:compile"
      ]
    },
    "test:only": {
      "command": "vitest run --project simply-atlassian",
      "env": {
        "FORCE_COLOR": "2"
      },
      "files": [
        "test/**/*.ts",
        "src/**/*.ts",
        "**/tsconfig.json",
        "../../tsconfig.json",
        "vitest.config.ts",
        "!*.nut.ts"
      ],
      "output": [],
      "dependencies": [
        "../simply-atlassian-core:compile"
      ]
    },
    "test:coverage": {
      "command": "vitest run --coverage --project simply-atlassian",
      "env": {
        "FORCE_COLOR": "2"
      },
      "dependencies": [
        "../simply-atlassian-core:compile"
      ],
      "files": [
        "test/**/*.ts",
        "src/**/*.ts",
        "**/tsconfig.json",
        "../../tsconfig.json",
        "vitest.config.ts",
        "!*.nut.ts"
      ],
      "output": [
        "coverage/**"
      ]
    },
    "test:watch": {
      "command": "vitest watch --project simply-atlassian",
      "env": {
        "FORCE_COLOR": "2"
      },
      "dependencies": [
        "../simply-atlassian-core:compile"
      ],
      "service": true
    }
  }
}
